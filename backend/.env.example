# ==============================================================================
# ShopLedger Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# Do NOT commit `backend/.env` or any service account JSON files to version control.
# ==============================================================================

# 1. Server Runtime
NODE_ENV=development
PORT=5001

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Production example: https://<YOUR_FIREBASE_PROJECT_ID>.web.app,https://<YOUR_FIREBASE_PROJECT_ID>.firebaseapp.com
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:5000

# 2. Firebase Project & Storage Configuration
FIREBASE_PROJECT_ID=<YOUR_FIREBASE_PROJECT_ID>
FIREBASE_STORAGE_BUCKET=<YOUR_FIREBASE_PROJECT_ID>.firebasestorage.app

# 3. Firebase Admin Authentication
# RECOMMENDED IN PRODUCTION (Cloud Run / GCP Managed Runtimes):
# Leave FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY unset.
# Firebase Admin SDK automatically uses Application Default Credentials (ADC)
# bound to the Cloud Run service account.
#
# LOCAL DEVELOPMENT OPTIONS:
# Option A (Recommended): Run `gcloud auth application-default login` or set:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account.json
#
# Option B: Use Firebase Local Emulator Suite:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
#
# Option C (Fallback only if ADC is unavailable):
# FIREBASE_CLIENT_EMAIL=<YOUR_SERVICE_ACCOUNT_EMAIL>
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<YOUR_PRIVATE_KEY>\n-----END PRIVATE KEY-----\n"

# 4. Google Gemini AI Configuration (Server-Side Only — Use Secret Manager in Production)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash
