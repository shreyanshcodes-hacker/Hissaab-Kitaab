{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed:db": "pnpm run build && node dist/scripts/seedFirestore.js",
