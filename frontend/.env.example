# ==============================================================================
# ShopLedger Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `frontend/.env` (or `frontend/.env.production` for production builds).
# Obtain these values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
#
# SECURITY WARNING:
# All VITE_* variables are bundled into the public browser JavaScript.
# NEVER put GEMINI_API_KEY, Firebase Admin private keys, or backend secrets here.
# ==============================================================================

VITE_FIREBASE_API_KEY=<YOUR_FIREBASE_WEB_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=<YOUR_FIREBASE_PROJECT_ID>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<YOUR_FIREBASE_PROJECT_ID>
VITE_FIREBASE_STORAGE_BUCKET=<YOUR_FIREBASE_PROJECT_ID>.firebasestorage.app
VITE_FIREBASE_APP_ID=<YOUR_FIREBASE_WEB_APP_ID>

# Express Backend API Base URL
# Local development: http://localhost:5001/api
# Production Cloud Run direct URL: https://<YOUR_CLOUD_RUN_SERVICE_URL>/api
# Production with Firebase Hosting /api/** rewrite: /api
VITE_API_BASE_URL=http://localhost:5001/api

# Optional: Set to "true" only when running against local Firebase Emulator Suite
# (Auth: 9099, Firestore: 8080, Storage: 9199)
VITE_USE_FIREBASE_EMULATORS=false
